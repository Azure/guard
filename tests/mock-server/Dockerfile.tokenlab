# Image carrying both tokenlab binaries. The manifest selects which one runs via
# `command:`, so a single build serves the probe Job and the proxy Deployment.
#
# alpine (not distroless/static) because both binaries make outbound TLS calls to
# Entra and need the CA bundle.
FROM alpine:3.20
RUN apk add --no-cache ca-certificates

COPY probe-linux-amd64 /probe
COPY token-proxy-linux-amd64 /token-proxy
RUN chmod +x /probe /token-proxy

USER 65534
ENTRYPOINT ["/token-proxy"]
